{
  "server": {
    "listen": ":8080",
    "max_request_body_bytes": 33554432,
    "read_header_timeout": "5s",
    "request_timeout": "10m",
    "shutdown_timeout": "30s"
  },
  "backend": {
    "base_url": "http://mock-backend:8000",
    "response_header_timeout": "30s",
    "idle_conn_timeout": "90s",
    "max_idle_conns": 100,
    "max_idle_conns_per_host": 100
  }
}
